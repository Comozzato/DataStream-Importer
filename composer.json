{
    "autoload": {
        "psr-4": {
            "App\\": "src\\App"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Wille Comozzato",
            "email": "dev.willeferreira@gmail.com"
        }
    ],
    "scripts": {
        "server": "php -S 0.0.0.0:9000 -t src/public",
        "lint": "phpcs -p --standard=PSR12 src",
        "fix": "phpcbf --standard=PSR12 src",
        "make:migration": "php src/public/make_migration.php",
        "migrate": "php src/public/migrate.php",
        "migrate:rollback": "php src/public/migrate.php rollback"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "*"
    },
    "require": {
        "duoshuo/php-cassandra": "^0.5.2",
        "vlucas/phpdotenv": "^5.6"
    }
}
